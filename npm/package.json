{
  "name": "pill-packer",
  "version": "0.1.0",
  "description": "PIL and PAC codecs backed by Rust WebAssembly",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./codec.wasm": "./codec.wasm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "codec.wasm",
    "LICENSE",
    "README.md"
