{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "declaration": true,
    "outDir": "portable",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "rootDir": "src"
  },
  "include": [
    "src/*.ts"
  ]
}
